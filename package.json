    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "konva": "^10.3.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-konva": "^19.2.5",
    "react-markdown": "^10.1.0",
